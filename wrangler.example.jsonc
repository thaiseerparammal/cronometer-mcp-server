/**
 * Wrangler configuration template.
 * Copy this file to `wrangler.jsonc` (it has no per-account ids to fill in).
 *
 * Secrets (NOT stored here — set with `wrangler secret put`):
 *   - MCP_AUTH_TOKEN       Static bearer token Claude must send to use the server.
 *                          Generate with: openssl rand -hex 32
 *   - CRONOMETER_EMAIL     Your Cronometer account email.
 *   - CRONOMETER_PASSWORD  Your Cronometer account password.
 *
 * Plain vars (set below, not secret):
 *   - TIMEZONE             IANA timezone your diary is kept in, e.g. "Asia/Kolkata".
 *                          Workers always run on a UTC clock, so leaving this at
 *                          "UTC" makes foods log with UTC dates and times.
 *
 * For more details: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cronometer-mcp-server",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["SessionStore"],
			"tag": "v2"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT"
			},
			{
				"class_name": "SessionStore",
				"name": "SESSION_STORE"
			}
		]
	},
	"vars": {
		// IANA timezone your Cronometer diary is kept in. A Worker's clock is
		// always UTC, so without this "today" and a logged meal's time are both
		// computed in UTC and land in the wrong day / hour.
		"TIMEZONE": "UTC"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"env": {
		"dev": {
			"name": "cronometer-mcp-server-dev",
			// Named environments do not inherit top-level `vars`, so repeat it.
			"vars": {
				"TIMEZONE": "UTC"
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MyMCP",
						"name": "MCP_OBJECT"
					}
				]
			}
		}
	}
}
